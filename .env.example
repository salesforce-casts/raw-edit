# RawEdit configuration
#
# Copy to `.env` and fill in. The web app and the worker read the same file locally;
# in production each is configured separately (see docs/deployment.md).
#
#   cp .env.example .env
#   ./scripts/dev-services.sh start
#   npm run dev            # web app
#   npm run dev:worker     # media worker (separate terminal)

# ─────────────────────────────────────────────────────────────── Database ──
# Neon in production. Vercel must use the POOLED endpoint (-pooler in the host);
# the worker and migrations use the direct one, because a pooler in transaction
# mode cannot run prepared statements or migrations.
DATABASE_URL="postgres://rawedit:rawedit@localhost:5432/rawedit"

# ────────────────────────────────────────────────────────────────── Redis ──
# Job queue and the progress channel the SSE endpoint forwards.
# Managed Redis usually gives you a rediss:// URL; TLS is enabled automatically.
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────────── Object storage (R2) ──
# Cloudflare R2, or any S3-compatible endpoint. The bucket MUST stay private:
# everything the browser touches is a short-lived signed URL.
#
# Local development uses MinIO, started by scripts/dev-services.sh.
R2_BUCKET="rawedit-dev"
R2_ENDPOINT="http://127.0.0.1:9000"
# For real R2 you can set the account id instead of the endpoint:
# R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="rawedit"
R2_SECRET_ACCESS_KEY="rawedit123"
R2_REGION="auto"

# ─────────────────────────────────────────────────────────────────── Auth ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Require a verified email before signing in. Needs an email provider wired up,
# so it is off by default.
# REQUIRE_EMAIL_VERIFICATION="0"

# Optional: Google sign-in. The same grant is reused for Drive import.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ────────────────────────────────────────────────────────── Transcription ──
# One of: deepgram | openai-whisper | faster-whisper
# Leave unset and RawEdit picks whichever credential is present, falling back to
# the self-hosted faster-whisper in the worker image.
TRANSCRIPTION_PROVIDER="faster-whisper"

# Hosted, fastest to set up. Word-level timings are required and this provides them.
# DEEPGRAM_API_KEY=""
# DEEPGRAM_MODEL="nova-3"

# Hosted Whisper. Note the 25MB upload cap, which is roughly 13 minutes of the
# 16kHz mono audio RawEdit extracts.
# OPENAI_API_KEY=""
# OPENAI_WHISPER_MODEL="whisper-1"

# Self-hosted. Build the worker image with --build-arg INSTALL_FASTER_WHISPER=1.
FASTER_WHISPER_MODEL="base.en"
FASTER_WHISPER_DEVICE="auto"     # auto | cpu | cuda
FASTER_WHISPER_COMPUTE="int8"    # int8 | int8_float16 | float16 | float32
# PYTHON_PATH="python3"

# ───────────────────────────────────────────────────────────── AI advisor ──
# Optional. When a take group is genuinely ambiguous, an LLM picks which attempt
# reads best. It is shown candidate TEXT and returns a candidate INDEX; it never
# sees or emits a timestamp and cannot create, move or delete a cut. Off by
# default, and the system is fully deterministic without it.
EDIT_ADVISOR="heuristic"         # heuristic | llm
# ANTHROPIC_API_KEY=""
# EDIT_ADVISOR_MODEL="claude-sonnet-5"
# EDIT_ADVISOR_MAX_GROUPS="25"

# ───────────────────────────────────────────────────────────────── Worker ──
# Jobs one replica runs at once. Raise with CPU; an ffmpeg render is CPU-bound.
WORKER_CONCURRENCY="2"
# Ceiling on jobs from a single account, so one creator queuing ten 4K renders
# cannot occupy the whole fleet.
MAX_CONCURRENT_JOBS_PER_USER="1"
# Scratch space for extracted audio and rendered output. Needs room for the
# largest file you accept plus its render.
WORKER_TMP_DIR="/tmp/rawedit"
# Signed-URL lifetime for ffmpeg's input. Must outlast your longest render.
SOURCE_URL_TTL_SECONDS="21600"
# Set to 0 on a render-only pool to skip proxy, thumbnail and waveform generation.
WORKER_GENERATE_PREVIEWS="1"
# FFMPEG_PATH="ffmpeg"
# FFPROBE_PATH="ffprobe"

LOG_LEVEL="info"                 # trace | debug | info | warn | error

# ──────────────────────────────────────────────────────────── Cloud import ──
# Optional. Public Drive links need an API key; a connected Google account uses
# OAuth instead. Dropbox public links need nothing. OneDrive needs a connected
# Microsoft account.
# GOOGLE_DRIVE_API_KEY=""

# ─────────────────────────────────────────────────────────── Upload tuning ──
# Set to 0 to skip the browser-side integrity hash on very old devices. The byte
# accounting checks still run either way.
# NEXT_PUBLIC_UPLOAD_HASHING="1"
