# Web + shared
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Raw Edit
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon (production) or Compose Postgres (local)
DATABASE_URL=postgresql://rawedit:rawedit@localhost:5432/rawedit
DATABASE_MIGRATE_URL=postgresql://rawedit:rawedit@localhost:5432/rawedit
DATABASE_DRIVER=postgres

# Cloudflare R2 (production) or MinIO (local S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=rawedit
R2_SECRET_ACCESS_KEY=raweditsecret
R2_BUCKET=rawedit-dev
R2_ENDPOINT=http://127.0.0.1:9000
R2_REGION=auto
R2_FORCE_PATH_STYLE=true

# Upstash Redis (production TLS) or Compose Redis (local)
REDIS_URL=redis://127.0.0.1:6379
UPSTASH_REDIS_HOST=
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=
UPSTASH_REDIS_TLS=false

# Worker
SERVICE_NAME=web
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_CONCURRENCY=1
RENDER_CONCURRENCY=1
MAX_CONCURRENT_JOBS_PER_USER=1
SOURCE_URL_TTL_SECONDS=3600
MAX_VIDEO_BYTES=21474836480
MAX_VIDEO_DURATION_SECONDS=3600
WORKER_SCRATCH_DIR=/tmp/rawedit
WORKER_TMP_DIR=/tmp/rawedit
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_API_KEY=
AI_PROVIDER=heuristic
AI_API_KEY=

# Optional observability
SENTRY_DSN=
POSTHOG_KEY=
RESEND_API_KEY=
LOG_LEVEL=info
